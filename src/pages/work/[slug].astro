---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import MetricChip from '../../components/MetricChip.astro';
import MetricViz from '../../components/MetricViz.astro';
import { cases, type Case } from '../../data/cases';
import { entries } from '../../data/timeline';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Case };
const entry = entries.find((e) => e.id === c.entry);
if (!entry) throw new Error(`Case ${c.slug} points at unknown entry ${c.entry}`);
---

<Base title={`${c.title} – Richard Dharmawan`} description={c.summary}>
  <article class="max-w-3xl pt-14">
    <a href={`/#entry-${entry.id}`} class="ink-link text-sm">← Back to the journey</a>
    <div class="mt-8 flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <span class="figure text-sm text-faint">{entry.date}</span>
      <Badge role={entry.role} ai={entry.aiAccelerated} />
    </div>
    <h1 class="display mt-3 text-[clamp(2.4rem,7vw,4rem)]">{c.title}</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted">{c.summary}</p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        c.metrics.map((id) => (
          <div class="space-y-2">
            <MetricChip id={id} />
            <MetricViz id={id} size="sm" />
          </div>
        ))
      }
    </div>

    {
      c.sections.map((s) => (
        <section class="mt-12">
          <h2 class="display text-2xl">{s.heading}</h2>
          <div class="mt-3 space-y-3 leading-relaxed text-muted">
            {s.body.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          {s.links && (
            <div class="mt-3 flex flex-wrap gap-5">
              {s.links.map((l) => (
                <a href={l.href} class="ink-link">
                  {l.label}
                </a>
              ))}
            </div>
          )}
        </section>
      ))
    }

    <p class="mt-14 text-sm text-faint">
      Every number links to how it was measured. <a href="/numbers/" class="ink-link text-muted">All the numbers</a>
    </p>
  </article>
</Base>
